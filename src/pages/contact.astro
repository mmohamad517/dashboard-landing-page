---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact | Best OutDoor Wears"
  description="Get in touch with Best OutDoor Wears — questions about TrailReady, a guide, or a correction."
  canonicalPath="/contact/"
>
  <section>
    <div class="wrap prose legal-page" style="max-width:74ch; padding-top:20px;">
      <h1>Contact</h1>
      <p>
        Have a question about TrailReady, a correction on one of our guides, or feedback on the site? We read
        everything that comes in.
      </p>
      <p class="affiliate-note">
        Email: <strong>{'{{CONTACT_EMAIL}}'}</strong> — placeholder until you provide a real inbox to publish
        here (a plain address or a form is fine — Formspree's free plan works well for a contact form with no
        backend needed).
      </p>
      <h2>Bug or typo in TrailReady?</h2>
      <p>
        Let us know which chapter and what's wrong — corrections are rolled into the next update, which every
        buyer receives free.
      </p>
    </div>
  </section>
</BaseLayout>
