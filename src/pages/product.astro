---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
import DeckMockup from '../components/DeckMockup.astro';

const categories = [
  { n: '12', name: 'Quick Hacks', color: '#3F7D4E', desc: 'Clever fixes from what you already have on you.' },
  { n: '12', name: 'Smart Shortcuts', color: '#2E6284', desc: 'Small habits that save weight, fuel and time.' },
  { n: '12', name: 'Survival Skills', color: '#C08A1E', desc: 'Navigation, water, shelter, fire, being found.' },
  { n: '10', name: 'Emergency Response', color: '#A8342A', desc: 'What to do first, and when to call for help.' },
  { n: '6', name: 'Multi-Use Items', color: '#5A5F55', desc: 'One object, many jobs.' },
  { n: '10', name: 'Safety & Planning', color: '#7A4B12', desc: 'The decisions made before you leave the house.' },
  { n: '10', name: 'Camp Cooking', color: '#B4611C', desc: 'Real food, one pot or a sheet of foil.' },
  { n: '7', name: '7-Day Challenge', color: '#5C4A86', desc: 'One skill a day in the week before a trip.' },
  { n: '10', name: 'Hard Choices', color: '#9C4A2F', desc: 'Scenarios with no comfortable answer.' },
];

const modes = [
  { n: '01', name: 'Survival Challenge', desc: 'Draw three. Explain how you\'d handle one, out loud, in under a minute. The group decides who they\'d rather be standing next to.' },
  { n: '02', name: 'Race The Clock', desc: 'Two teams, one card, same start. First working shelter, fire or filter wins.' },
  { n: '03', name: 'Priority Sort', desc: 'Five cards face up. Rank them by what you\'d deal with first — then change the setting and watch the order change.' },
  { n: '04', name: 'Do It Blind', desc: 'Read only the title. Try the skill before you read the steps. You remember what you got wrong.' },
  { n: '05', name: 'Hard Choices', desc: 'Everyone commits to A, B or C out loud before anyone reads the answer. Then argue about it.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Survival Cards — Outdoor Skills Card Deck',
  description: 'An 89-card printable deck that teaches outdoor survival and safety skills as a game: quick hacks, survival skills, emergency response, camp cooking, a 7-day challenge and scenario cards.',
  brand: { '@type': 'Brand', name: 'Best OutDoor Wears' },
  offers: {
    '@type': 'Offer',
    price: '14.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://bestoutdoorwears.com/product/',
  },
};
---
<BaseLayout
  title="Survival Cards — An 89-Card Outdoor Skills Deck | Best OutDoor Wears"
  description="A printable 89-card deck that teaches outdoor survival and safety skills as a game — quick hacks, navigation, emergency response, camp cooking, and a 7-day pre-trip challenge."
  canonicalPath="/product/"
  structuredData={structuredData}
>
  <section>
    <div class="wrap product-grid">
      <div>
        <DeckMockup width={250} />
      </div>
      <div class="product-copy">
        <span class="label">The Deck</span>
        <h1>Survival Cards</h1>
        <p>
          Eighty-nine cards that teach you what to do outdoors — by playing, arguing, and getting it wrong
          somewhere safe. Print it, cut it, and it lives in the lid of your pack.
        </p>
        <div class="product-includes">
          <div class="item"><span class="n">01</span><div><h4>52 core cards</h4><p>Quick hacks, smart shortcuts, survival skills, emergency response and multi-use kit.</p></div></div>
          <div class="item"><span class="n">02</span><div><h4>37 expansion cards</h4><p>Safety &amp; planning, camp cooking, a seven-day skills challenge, and ten scenario cards.</p></div></div>
          <div class="item"><span class="n">03</span><div><h4>The guide (PDF)</h4><p>Five ways to play, how to read a card, printing instructions, and where this deck's limits are.</p></div></div>
          <div class="item"><span class="n">04</span><div><h4>Print-ready</h4><p>Nine cards a page with cut guides. Colour-coded so you find the right one fast.</p></div></div>
        </div>
        <div class="price-tag">
          <span class="price">$14</span>
          <span class="was">one-time · instant download</span>
        </div>
        <div class="hero-actions" style="margin-top:22px;">
          <a class="btn btn-primary" href="#buy">Get the deck</a>
          <a class="btn btn-ghost" href={url('/downloads/survival-cards-free-sample.pdf')}>Free 8-card sample</a>
        </div>
        <p class="affiliate-note" id="buy">
          Checkout link pending — the store listing is being finished. This page will link straight to a
          secure, instant-download checkout once it's live.
        </p>
      </div>
    </div>
  </section>

  <section class="product-section">
    <div class="wrap">
      <div class="section-head">
        <h2>Nine colours,<br>one job each</h2>
        <p class="desc">Colour tells you what kind of card you're holding before you read a word of it.</p>
      </div>
      <div class="cat-grid">
        {categories.map((c) => (
          <div class="cat-card" style={`--cat:${c.color}`}>
            <span class="cat-count">{c.n}</span>
            <div>
              <h3>{c.name}</h3>
              <p>{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>Five ways to play</h2>
        <p class="desc">Two players or ten. No board, no timer, no setup.</p>
      </div>
      <div class="chapters">
        {modes.map((m) => (
          <div class="chapter-card">
            <span class="cnum">{m.n}</span>
            <div>
              <h3>{m.name}</h3>
              <p>{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="product-section">
    <div class="wrap prose" style="max-width:74ch;">
      <h2>Who this is for</h2>
      <p>
        Beginners and families heading somewhere fairly normal — a campsite, a marked trail, a weekend in the
        hills. Scout groups and youth leaders who want something to do round a fire that isn't a lecture. If
        you already teach this stuff for a living, you don't need it.
      </p>
      <h2>What it isn't</h2>
      <p>
        It isn't a wilderness medicine manual and it isn't a substitute for a first aid course — the emergency
        cards are memory aids for people who have been taught this material, not a way to learn it cold. It
        also deliberately doesn't teach you to identify wild plants or mushrooms: deadly and edible species
        look alike, field tests don't reliably work, and a healthy adult can go a long time without food.
        That card tells you to leave it alone, and explains why.
      </p>
      <h2>A note on fire and local rules</h2>
      <p>
        Several cards involve flame. Fire rules vary enormously by region and season, and in many places open
        fires are banned outright for part of the year. Check before you light anything.
      </p>
    </div>
  </section>
</BaseLayout>
