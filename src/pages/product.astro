---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
import KitMockup from '../components/KitMockup.astro';

const partOne = [
  { n: '01', name: 'The Layering Guide', desc: 'Base / mid / shell explained once, so you can build a clothing list for any trip from the forecast alone.' },
  { n: '02', name: '5 Trip-Type Chapters', desc: 'Day hike, overnight backpacking, car camping, cold-weather and wet-weather — each with what to wear, a tap-to-check packing list, a quick recipe, and what to do when caught without the right layer.' },
  { n: '03', name: 'Conditions Helper', desc: 'A working spreadsheet. Pick your trip type and the weather; it returns the layering list.' },
];

const partTwo = [
  { n: '04', name: '52 core cards', desc: 'Quick hacks, smart shortcuts, survival skills, emergency response and multi-use kit.' },
  { n: '05', name: '37 expansion cards', desc: 'Safety & planning, camp cooking, a seven-day skills challenge, and ten scenario cards.' },
  { n: '06', name: 'The deck guide', desc: 'Five ways to play, how to read a card, printing instructions, and where the deck\'s limits are.' },
];

const categories = [
  { n: '12', name: 'Quick Hacks', color: '#3F7D4E', desc: 'Clever fixes from what you already have on you.' },
  { n: '12', name: 'Smart Shortcuts', color: '#2E6284', desc: 'Small habits that save weight, fuel and time.' },
  { n: '12', name: 'Survival Skills', color: '#C08A1E', desc: 'Navigation, water, shelter, fire, being found.' },
  { n: '10', name: 'Emergency Response', color: '#A8342A', desc: 'What to do first, and when to call for help.' },
  { n: '6', name: 'Multi-Use Items', color: '#5A5F55', desc: 'One object, many jobs.' },
  { n: '10', name: 'Safety & Planning', color: '#7A4B12', desc: 'The decisions made before you leave the house.' },
  { n: '10', name: 'Camp Cooking', color: '#B4611C', desc: 'Real food, one pot or a sheet of foil.' },
  { n: '7', name: '7-Day Challenge', color: '#5C4A86', desc: 'One skill a day in the week before a trip.' },
  { n: '10', name: 'Hard Choices', color: '#9C4A2F', desc: 'Scenarios with no comfortable answer.' },
];

const modes = [
  { n: '01', name: 'Survival Challenge', desc: 'Draw three. Explain how you\'d handle one, out loud, in under a minute.' },
  { n: '02', name: 'Race The Clock', desc: 'Two teams, one card, same start. First working shelter, fire or filter wins.' },
  { n: '03', name: 'Priority Sort', desc: 'Rank five cards by what you\'d deal with first — then change the setting and watch the order change.' },
  { n: '04', name: 'Do It Blind', desc: 'Read only the title. Try the skill before you read the steps.' },
  { n: '05', name: 'Hard Choices', desc: 'Everyone commits to A, B or C out loud before anyone reads the answer.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'TrailReady — The Complete Outdoor Kit',
  description: 'A layering and packing system for five trip types, a working conditions spreadsheet, and an 89-card survival skills deck with its guide — one download.',
  brand: { '@type': 'Brand', name: 'Best OutDoor Wears' },
  offers: {
    '@type': 'Offer',
    price: '19.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://bestoutdoorwears.com/product/',
  },
};
---
<BaseLayout
  title="TrailReady — The Complete Outdoor Kit | Best OutDoor Wears"
  description="Everything for a trip in one download: a layering and packing system for five trip types, a working conditions spreadsheet, and an 89-card survival skills deck."
  canonicalPath="/product/"
  structuredData={structuredData}
>
  <section>
    <div class="wrap product-grid">
      <div>
        <KitMockup width={300} />
      </div>
      <div class="product-copy">
        <span class="label">The Complete Kit</span>
        <h1>TrailReady</h1>
        <p>
          Two halves of the same problem. The guide gets you out the door with the right things on
          your back. The deck means you know what to do when the day stops going to plan.
        </p>

        <div class="kit-split">
          <span class="kit-split-label">Part one — before you go</span>
          <div class="product-includes">
            {partOne.map((i) => (
              <div class="item"><span class="n">{i.n}</span><div><h4>{i.name}</h4><p>{i.desc}</p></div></div>
            ))}
          </div>
          <span class="kit-split-label">Part two — when it goes wrong</span>
          <div class="product-includes">
            {partTwo.map((i) => (
              <div class="item"><span class="n">{i.n}</span><div><h4>{i.name}</h4><p>{i.desc}</p></div></div>
            ))}
          </div>
        </div>

        <div class="price-tag">
          <span class="price">$19</span>
          <span class="was">one-time · instant download · both parts</span>
        </div>
        <div class="hero-actions" style="margin-top:22px;">
          <a class="btn btn-primary" href="#buy">Get the kit</a>
          <a class="btn btn-ghost" href={url('/downloads/trailready-free-sample.pdf')}>Free sample</a>
        </div>
        <p class="affiliate-note" id="buy">
          Checkout link pending — the store listing is being finished. This page will link straight to a
          secure, instant-download checkout once it's live.
        </p>
      </div>
    </div>
  </section>

  <section class="product-section">
    <div class="wrap">
      <div class="section-head">
        <h2>Part two:<br>nine colours, one job each</h2>
        <p class="desc">Colour tells you what kind of card you're holding before you read a word of it.</p>
      </div>
      <div class="cat-grid">
        {categories.map((c) => (
          <div class="cat-card" style={`--cat:${c.color}`}>
            <span class="cat-count">{c.n}</span>
            <div>
              <h3>{c.name}</h3>
              <p>{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>Five ways to play the deck</h2>
        <p class="desc">Two players or ten. No board, no timer, no setup.</p>
      </div>
      <div class="chapters">
        {modes.map((m) => (
          <div class="chapter-card">
            <span class="cnum">{m.n}</span>
            <div>
              <h3>{m.name}</h3>
              <p>{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="product-section">
    <div class="wrap prose" style="max-width:74ch;">
      <h2>Why the two halves belong together</h2>
      <p>
        Packing well is what stops most problems from starting. Knowing what to do is what stops the
        remaining ones from getting worse. Sold separately they each leave a gap: a perfect packing list
        does nothing for you at the moment something goes wrong, and a survival deck does not stop you
        arriving cold and wet in the first place.
      </p>
      <h2>Who this is for</h2>
      <p>
        Beginners and families heading somewhere fairly normal — a campsite, a marked trail, a weekend in
        the hills. Scout groups and youth leaders who want something to do round a fire that isn't a
        lecture. If you already teach this for a living, you don't need it.
      </p>
      <h2>What it isn't</h2>
      <p>
        It isn't a wilderness medicine manual and it isn't a substitute for a first aid course — the
        emergency cards are memory aids for people who have been taught this material, not a way to learn
        it cold. It also deliberately doesn't teach you to identify wild plants or mushrooms: deadly and
        edible species look alike, field tests don't reliably work, and a healthy adult can go a long
        time without food. That card tells you to leave it alone, and explains why.
      </p>
      <h2>A note on fire and local rules</h2>
      <p>
        Several cards involve flame. Fire rules vary enormously by region and season, and in many places
        open fires are banned outright for part of the year. Check before you light anything.
      </p>
    </div>
  </section>
</BaseLayout>
