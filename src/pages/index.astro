---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

const heroImg = 'https://images.unsplash.com/photo-1586022045497-31fcf76fa6cc?crop=entropy&cs=tinysrgb&fit=max&fm=webp&q=75&w=900';

const secondaryKeywords = [
  'how to layer clothes for hiking', 'day hike packing list', 'backpacking packing checklist',
  'winter hiking layering system', 'base layer vs mid layer', 'how to choose a hiking jacket',
  'rain jacket vs shell jacket for hiking', 'what to wear camping in fall',
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Best OutDoor Wears',
    url: 'https://bestoutdoorwears.com',
    description: 'A layering and packing system for outdoor beginners, built around TrailReady.',
  },
];
---
<BaseLayout
  title="Outdoor Clothing Layering Guide: What to Wear Hiking & Camping | Best OutDoor Wears"
  description="A complete outdoor clothing layering guide: how to dress for hiking, camping, and changing weather, plus a printable packing system for 5 trip types — TrailReady."
  canonicalPath="/"
  structuredData={structuredData}
>
  <section class="hero">
    <svg class="contour-bg" viewBox="0 0 1200 520" preserveAspectRatio="none" aria-hidden="true">
      <g fill="none" stroke="#8AA290" stroke-width="1.4">
        <path d="M-50 60 C 250 10, 500 130, 780 40 S 1250 90 1300 40" />
        <path d="M-50 130 C 220 70, 520 200, 800 110 S 1250 160 1300 110" />
        <path d="M-50 200 C 260 150, 540 270, 820 180 S 1250 230 1300 180" />
        <path d="M-50 270 C 240 220, 560 330, 840 250 S 1250 300 1300 250" />
      </g>
    </svg>
    <div class="wrap hero-inner">
      <div class="hero-grid">
        <div>
          <span class="label">Outdoor Clothing Layering Guide</span>
          <h1>Stop guessing<br>what to <span class="accent">wear</span> outside.</h1>
          <p class="lede">
            You already know where you're hiking. This guide — and the TrailReady system built from it —
            tells you exactly what to layer, wear, and pack for the trip, so you're never the one shivering,
            soaked, or hauling gear you didn't need.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/product/">Get TrailReady — $12</a>
            <a class="btn btn-ghost" href="#layers">Read the layering system ↓</a>
          </div>
          <p style="margin-top:14px;">
            <a href="/downloads/trailready-free-cheatsheet.pdf">Free download: the Universal Layering Cheat Sheet (1 page, no email required) →</a>
          </p>
        </div>
        <div>
          <div class="hero-photo">
            <img src={heroImg} width="900" height="1125" loading="eager" fetchpriority="high"
                 alt="A hiker with a large backpack crossing a rocky ridge at golden hour" />
          </div>
          <p class="photo-credit">Photo: Lucas Favre / Unsplash</p>
        </div>
      </div>
    </div>
  </section>

  <section class="problem" id="problem">
    <div class="wrap">
      <div class="section-head">
        <h2>Every trip, the<br>same three mistakes</h2>
        <p class="desc">Not gear failures. Clothing decisions — made the night before, in the dark.</p>
      </div>
    </div>
    <div class="problem-grid">
      <div class="problem-card">
        <div class="num">01 / COLD</div>
        <h3>Underdressed at altitude</h3>
        <p>Warm at the trailhead, freezing by the ridge — because the plan was "wear a jacket," not a layering system.</p>
      </div>
      <div class="problem-card">
        <div class="num">02 / SOAKED</div>
        <h3>Wrong fabric, wrong day</h3>
        <p>Cotton feels fine at the car. Two miles in, it's holding sweat or rain against your skin all the way back.</p>
      </div>
      <div class="problem-card">
        <div class="num">03 / OVERLOADED</div>
        <h3>Packed for every scenario</h3>
        <p>Three jackets "just in case" — and a pack heavy enough to end the trip two hours early.</p>
      </div>
    </div>
  </section>

  <section id="layers">
    <div class="wrap">
      <div class="section-head">
        <h2>One system.<br>Every condition.</h2>
        <p class="desc">The same three-layer logic outdoor guides have used for decades — made specific to your trip.</p>
      </div>
      <div class="layers">
        <div class="layer-card layer-1">
          <span class="layer-index">LAYER 01</span>
          <h3>Base</h3>
          <div class="swatch"></div>
          <p>Sits against your skin, moves sweat away. The layer you wear on every single trip, regardless of weather.</p>
        </div>
        <div class="layer-card layer-2">
          <span class="layer-index">LAYER 02</span>
          <h3>Mid</h3>
          <div class="swatch"></div>
          <p>Your insulation. On at rest stops and ridgelines, off the second you're climbing hard and warm.</p>
        </div>
        <div class="layer-card layer-3">
          <span class="layer-index">LAYER 03</span>
          <h3>Shell</h3>
          <div class="swatch"></div>
          <p>Blocks wind and rain without trapping the heat you're generating. Your last line before you turn back.</p>
        </div>
      </div>

      <div class="prose" style="margin-top:44px; max-width:74ch;">
        <h2>Why "just wear a jacket" doesn't work</h2>
        <p>
          Most beginners think about outdoor clothing the way they think about everyday clothing: pick an outfit
          for the weather, put it on, done. That works for a walk to the store. It doesn't work for three hours
          on a trail, because the conditions around your body change constantly even when the forecast doesn't —
          your effort level swings from a flat warm-up to a steep, sweaty climb to a windy, exposed ridge to a
          slow, cooling descent, sometimes within the same hour. A single "outfit" can't track that. A layering
          system can, because each layer has one job, and you add or remove it independently as your body and
          the weather change.
        </p>
        <h3>Base layer: the one you never skip</h3>
        <p>
          Your base layer sits against your skin and has exactly one job: move sweat away from your body so it
          can evaporate. This is the layer people get wrong most often, usually by wearing cotton. Cotton feels
          soft and comfortable at the trailhead, but it absorbs moisture and holds onto it — once a cotton
          t-shirt is wet from sweat or rain, it stays wet, and wet fabric against your skin pulls heat away from
          your body far faster than dry fabric does. That's fine on a warm afternoon. It's genuinely dangerous
          in cold or windy conditions, where it's a real contributor to hypothermia even at temperatures well
          above freezing. Merino wool and synthetic technical fabrics (polyester, nylon blends) solve this by
          wicking moisture to the outer surface where it can evaporate, so you stay dry even when you're
          sweating hard.
        </p>
        <h3>Mid layer: on and off, not on all day</h3>
        <p>
          The mid layer is your insulation — a fleece, a light puffy, or a wool sweater — and its job is to trap
          the warm air your body generates. The mistake here isn't fabric choice, it's timing: people put the
          mid layer on at the trailhead and leave it on for the whole hike, which means they're sweating through
          it within twenty minutes of climbing. The mid layer is meant to come on and off throughout the day —
          on at rest stops, at the summit, on an exposed ridge in the wind; off the moment you're moving hard
          enough to generate your own heat. Packing it somewhere quick to reach (a pocket, not the bottom of your
          bag) makes this realistic instead of annoying.
        </p>
        <h3>Shell layer: your weather insurance</h3>
        <p>
          The outer shell blocks wind and rain while letting the heat and moisture your body produces escape —
          that combination is what "breathable waterproof" actually means. Without a shell, a wet base and mid
          layer lose heat fast enough that even a mild, 50°F (10°C) day with wind and rain can produce
          hypothermia symptoms on an exposed trail. A packable wind/rain shell weighs very little and takes up
          almost no space, which is exactly why "just in case" is a reasonable argument for carrying one on
          nearly every trip, even when the forecast looks clear — mountain weather changes faster than forecasts
          update, and ridgelines are commonly 10–15°F colder and windier than the trailhead.
        </p>
        <h3>Translating a weather app into a layering decision</h3>
        <p>
          Checking the weather is standard advice that most guides stop at. The more useful skill is turning that
          forecast into an actual clothing decision, because temperature alone doesn't tell you what to wear —
          wind and your own effort level matter just as much. A rule of thumb worth internalizing: start your
          hike slightly cold, not comfortable. If you feel warm and cozy standing at the trailhead, you will
          overheat within the first ten minutes of climbing. Layer for the walk, not for standing still, and
          keep the layer you shed within arm's reach for the moment you stop moving and the cold catches up.
        </p>
      </div>
    </div>
  </section>

  <section class="product-section" id="product-teaser">
    <div class="wrap">
      <div class="section-head">
        <h2>TrailReady: the system,<br>in your pocket</h2>
        <p class="desc">Everything above, broken down for 5 trip types, plus packing, quick recipes, and emergency workarounds.</p>
      </div>
      <div class="product-grid">
        <div>
          <div class="product-includes">
            <div class="item"><span class="n">01</span><div><h4>The Layering Guide</h4><p>Base / mid / shell explained once, applied to every future trip.</p></div></div>
            <div class="item"><span class="n">02</span><div><h4>5 Trip-Type Chapters</h4><p>Day hike, overnight backpack, car camping, cold-weather, wet-weather — each with layering, packing, quick recipes, and buying picks.</p></div></div>
            <div class="item"><span class="n">03</span><div><h4>Conditions Helper (Sheet)</h4><p>A working spreadsheet: pick your trip type and weather, get your layering list back — live formulas, not a static PDF.</p></div></div>
            <div class="item"><span class="n">04</span><div><h4>Fillable Checklists</h4><p>Tap-to-check boxes that work on your phone or tablet, not just on paper.</p></div></div>
          </div>
          <div class="price-tag">
            <span class="price">$12</span>
            <span class="was">one-time · instant download</span>
          </div>
          <div class="hero-actions" style="margin-top:20px;">
            <a class="btn btn-primary" href="/product/">See what's inside →</a>
          </div>
        </div>
        <div class="prose" style="max-width:52ch;">
          <p>
            A packing checklist alone doesn't fix bad clothing decisions — that's why most generic camping
            checklists don't actually solve the problem most beginners have. TrailReady leads with the layering
            system because that's what actually determines whether you're comfortable, then backs it up with the
            gear, food, and buying guidance for each specific trip type, so you're not re-deriving the same
            decisions from scratch every time you plan a trip.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="articles">
    <div class="wrap">
      <div class="section-head">
        <h2>Guides &amp; deep dives</h2>
        <p class="desc">Every question we get about layering, packing, and outdoor clothing, answered in full.</p>
      </div>
      <div class="article-grid">
        {articles.map((a) => (
          <a class="article-card" href={`/articles/${a.slug}/`}>
            <span class="label">{a.data.keyword}</span>
            <h3>{a.data.title}</h3>
            <p>{a.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="kw">
    <div class="wrap">
      <div class="section-head">
        <h2>What this covers</h2>
      </div>
      <div class="kw-list">
        <span class="primary">outdoor clothing layering guide</span>
        {secondaryKeywords.map((k) => <span>{k}</span>)}
        <span>+ 12 more →</span>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap" style="max-width:74ch;">
      <div class="section-head">
        <h2>Quick answers</h2>
      </div>
      <details class="faq-item">
        <summary>Do I really need three separate layers for a short day hike?</summary>
        <p>Not always worn at once — but carrying the option matters. On a short, warm, low-elevation hike you
          may hike in just a base layer with a shell in your pack "just in case." The system isn't about
          wearing everything; it's about having the right piece available for the moment you need it.</p>
      </details>
      <details class="faq-item">
        <summary>What fabric should I avoid most?</summary>
        <p>Cotton, in cold or wet conditions specifically. It's fine for a warm, dry, low-effort walk — the
          problem is what happens once it gets wet from sweat or rain and stops insulating.</p>
      </details>
      <details class="faq-item">
        <summary>Is TrailReady a physical product?</summary>
        <p>No — it's an instant digital download (PDF guide and checklists, plus a working spreadsheet tool).
          You get access immediately after purchase, nothing ships.</p>
      </details>
      <p style="margin-top:20px;"><a href="/faq/">See the full FAQ →</a></p>
    </div>
  </section>
</BaseLayout>
