---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/paths';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const allArticles = await getCollection('articles');

const related = article.data.relatedSlugs
  .map((slug) => allArticles.find((a) => a.slug === slug))
  .filter(Boolean);

// Derived from the article's own "## Quick answers" section, if it has one,
// rather than duplicated in frontmatter - one source of text, so the visible
// answer and the schema answer can never drift apart. New articles pick this
// up automatically the moment they add the section, no template change needed.
function extractFaq(markdown: string) {
  const section = markdown.match(/^## Quick answers\n([\s\S]*?)(?=\n## )/m);
  if (!section) return [];
  const pairs = [...section[1].matchAll(/\*\*(.+?)\*\*\n([\s\S]*?)(?=\n\*\*|\n*$)/g)];
  return pairs.map(([, question, answer]) => ({
    question: question.trim(),
    // Strip markdown links down to their visible text - schema text should read as plain prose.
    answer: answer.trim().replace(/\[([^\]]+)\]\([^)]+\)/g, '$1'),
  }));
}

const faq = extractFaq(article.body);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.data.title,
    description: article.data.description,
    author: { '@type': 'Organization', name: article.data.author },
    datePublished: article.data.pubDate.toISOString(),
    dateModified: article.data.updatedDate.toISOString(),
    publisher: { '@type': 'Organization', name: 'Best OutDoor Wears' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bestoutdoorwears.com/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://bestoutdoorwears.com/#articles' },
      { '@type': 'ListItem', position: 3, name: article.data.title, item: `https://bestoutdoorwears.com/articles/${article.slug}/` },
    ],
  },
  ...(faq.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  }] : []),
];
---
<BaseLayout
  {/* No brand suffix: it costs 21 characters of a 60-character SERP
      title, and the domain is already shown beside it. */}
  title={article.data.title}
  description={article.data.description}
  canonicalPath={`/articles/${article.slug}/`}
  structuredData={structuredData}
>
  <article>
    <div class="wrap" style="max-width:74ch; padding-top:34px;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a> / <a href={url('/#articles')}>Guides</a> / {article.data.title}
      </nav>
      <header class="article-header">
        <span class="label">{article.data.keyword}</span>
        <h1>{article.data.title}</h1>
        <div class="article-meta">
          <span>By {article.data.author}</span>
          <time datetime={article.data.pubDate.toISOString()}>Published {article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <time datetime={article.data.updatedDate.toISOString()}>Updated {article.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>

      <div class="article-cta">
        <h3>Learn it properly, before you need it</h3>
        <p>Survival Cards turns this and 88 other skills into a deck you can play round a fire — $19, print at
          home. <a href={url('/product/')}>See what's inside →</a></p>
      </div>

      {related.length > 0 && (
        <div>
          <h2 style="font-size:1.3rem; margin-bottom:16px;">Related guides</h2>
          <div class="article-grid">
            {related.map((r) => r && (
              <a class="article-card" href={url(`/articles/${r.slug}/`)}>
                <span class="label">{r.data.keyword}</span>
                <h3>{r.data.title}</h3>
                <p>{r.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</BaseLayout>
