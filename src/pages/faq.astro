---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: "Is Survival Cards a first aid course?",
    a: "No, and it says so on the cards. The emergency cards are memory prompts for people who have already been taught this material. If you take one action after buying the deck, book a real first aid course.",
  },
  {
    q: "Does the deck teach foraging or mushroom identification?",
    a: "Deliberately not. Deadly and edible species look alike, field tests do not reliably work, and experienced foragers still get it wrong. The deck teaches the correct survival priority instead: a healthy adult can go a long time without food, so the effort belongs elsewhere.",
  },
  {
    q: "Is this a physical deck of cards?",
    a: "No. It is a print-at-home PDF, nine cards to a page with cut guides. Nothing ships, you get it immediately, and you can reprint any card you lose or soak.",
  },
  {
    q: "What do I need to print it?",
    a: "Any home printer. Heavier paper lasts longer, and colour helps because the colours are how you find a card quickly, but plain black-and-white paper still works.",
  },
  {
    q: "How many cards are there?",
    a: "89 in total: 52 core cards across five colours, plus 37 expansion cards covering safety and planning, camp cooking, a seven-day skills challenge, and ten scenario cards.",
  },
  {
    q: "Is it suitable for children?",
    a: "The game modes work well with families and youth groups, and several cards are written for exactly that. Anything involving flame or knives needs an adult, and the emergency cards are written for the adult in the group.",
  },
  {
    q: "Does it cover emergency numbers for my country?",
    a: "It covers the widely used international numbers and tells you to look up and write down the local number for wherever you are going. Numbers vary and change, so we do not print a country list that could go stale.",
  },
  {
    q: "Will the deck get updates?",
    a: "Yes — corrections and additions go out free to everyone who has bought it, through the same download link.",
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="FAQ | Best OutDoor Wears"
  description="Frequently asked questions about Survival Cards — what is in the deck, printing it, and what it deliberately does not teach."
  canonicalPath="/faq/"
  structuredData={structuredData}
>
  <section>
    <div class="wrap" style="max-width:74ch; padding-top:20px;">
      <h1>Frequently Asked Questions</h1>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
