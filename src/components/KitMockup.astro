---
import { url } from '../lib/paths';

interface Props {
  /** Width of the book cover, in pixels. The deck scales from it. */
  width?: number;
}

const { width = 300 } = Astro.props;
const art = url('/images/IMG_8867.jpeg');

const fan = [
  { rot: -14, x: -30, y: 8, color: 'var(--card-green)' },
  { rot: -6, x: -15, y: 3, color: 'var(--card-yellow)' },
  { rot: 7, x: 16, y: 4, color: 'var(--card-blue)' },
  { rot: 15, x: 32, y: 9, color: 'var(--card-red)' },
];
---
<div class="kit-mockup" style={`--book-w:${width}px`}>
  <div class="kit-book">
    <div class="kit-book-cover">
      <img src={art} alt="" aria-hidden="true" class="kit-art" />
      <div class="kit-face">
        <span class="kit-brand">Best OutDoor Wears</span>
        <span class="kit-title">TrailReady</span>
        <span class="kit-rule" aria-hidden="true"></span>
        <span class="kit-sub">The Complete<br />Outdoor Kit</span>
        <span class="kit-foot">Plan it · pack it</span>
      </div>
    </div>
    <div class="kit-pages" aria-hidden="true"></div>
  </div>

  <div class="kit-deck">
    {fan.map((f) => (
      <div class="kit-card-back" style={`--rot:${f.rot}deg; --tx:${f.x}px; --ty:${f.y}px; --tint:${f.color}`} />
    ))}
    <div class="kit-card-front">
      <span class="kit-card-label">Survival<br />Cards</span>
      <span class="kit-card-count">89</span>
    </div>
  </div>
</div>

<style>
  .kit-mockup {
    --book-h: calc(var(--book-w) * 1.4);
    --card-w: calc(var(--book-w) * 0.52);
    --card-h: calc(var(--card-w) * 1.4);
    --card-green: #3F7D4E;
    --card-blue: #2E6284;
    --card-yellow: #C08A1E;
    --card-red: #A8342A;
    position: relative;
    width: 100%;
    /* room for the deck, which overlaps the book's lower right corner */
    min-height: calc(var(--book-h) + var(--card-h) * 0.42);
    display: flex;
    justify-content: center;
    padding: 20px 0 12px;
    perspective: 1500px;
  }

  .kit-book {
    position: relative;
    width: var(--book-w);
    height: var(--book-h);
    transform-style: preserve-3d;
    transform: rotateY(-17deg) rotateX(3deg);
    filter: drop-shadow(0 26px 32px rgba(11, 20, 14, 0.42));
  }

  .kit-book-cover {
    position: absolute;
    inset: 0;
    border-radius: 3px 7px 7px 3px;
    overflow: hidden;
    background: #14261D;
  }

  .kit-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.60) saturate(0.9);
  }

  .kit-book-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.28) 4%,
        rgba(255,255,255,0.10) 7%, rgba(0,0,0,0) 16%),
      linear-gradient(180deg,
        rgba(11,18,10,0.28) 0%, rgba(11,18,10,0.60) 60%, rgba(11,18,10,0.86) 100%);
  }

  .kit-face {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: calc(var(--book-w) * 0.11) calc(var(--book-w) * 0.08)
             calc(var(--book-w) * 0.085) calc(var(--book-w) * 0.125);
    color: #fff;
  }

  .kit-brand {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: calc(var(--book-w) * 0.037);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #F0B08A;
  }

  .kit-title {
    font-family: "Big Shoulders Display", "Arial Narrow", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.9;
    font-size: calc(var(--book-w) * 0.20);
    margin-top: calc(var(--book-w) * 0.05);
  }

  .kit-rule {
    display: block;
    width: calc(var(--book-w) * 0.21);
    height: 3px;
    background: #B84E1F;
    margin: calc(var(--book-w) * 0.05) 0;
  }

  .kit-sub {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: calc(var(--book-w) * 0.068);
    line-height: 1.28;
    color: #E4EADF;
  }

  .kit-foot {
    margin-top: auto;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: calc(var(--book-w) * 0.032);
    letter-spacing: 0.04em;
    color: #C2CFBC;
    white-space: nowrap;
  }

  .kit-pages {
    position: absolute;
    top: 1.5%;
    right: 0;
    height: 97%;
    width: calc(var(--book-w) * 0.05);
    transform: translateX(99%) rotateY(78deg);
    transform-origin: left center;
    background: repeating-linear-gradient(90deg,
      #f4f2e7 0 1px, #d9d6c4 1px 2px, #fbfaf3 2px 3px);
  }

  /* ---- the deck, overlapping the book's lower right ---- */
  .kit-deck {
    position: absolute;
    right: calc(50% - var(--book-w) * 0.86);
    bottom: 0;
    width: var(--card-w);
    height: var(--card-h);
    z-index: 3;
  }

  .kit-card-back,
  .kit-card-front {
    position: absolute;
    inset: 0;
    border-radius: 7px;
  }

  .kit-card-back {
    background: var(--tint);
    transform: translate(var(--tx), var(--ty)) rotate(var(--rot));
    border: 2px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 8px 18px -10px rgba(11, 20, 14, 0.5);
  }

  .kit-card-front {
    background: #14261D;
    border: 2px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 16px 30px -12px rgba(11, 20, 14, 0.6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--card-w) * 0.13);
  }

  .kit-card-label {
    font-family: "Big Shoulders Display", "Arial Narrow", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.9;
    font-size: calc(var(--card-w) * 0.20);
    color: #fff;
  }

  .kit-card-count {
    font-family: "Big Shoulders Display", sans-serif;
    font-weight: 800;
    font-size: calc(var(--card-w) * 0.30);
    color: #FF8F55;
    align-self: flex-end;
    line-height: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .kit-book, .kit-card-back { transition: transform 0.5s ease; }
    .kit-mockup:hover .kit-book { transform: rotateY(-10deg) rotateX(2deg); }
    .kit-mockup:hover .kit-card-back {
      transform: translate(calc(var(--tx) * 1.4), var(--ty)) rotate(calc(var(--rot) * 1.3));
    }
  }

  @media (max-width: 620px) {
    .kit-mockup { --book-w: 210px; }
  }
</style>
