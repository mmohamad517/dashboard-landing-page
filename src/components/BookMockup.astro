---
import { url } from '../lib/paths';

interface Props {
  /** Rendered width of the book in pixels. */
  width?: number;
}

const { width = 300 } = Astro.props;
const cover = url('/images/IMG_8867.jpeg');
---
<div class="book-mockup" style={`--book-w:${width}px`}>
  <div class="book">
    <div class="book-cover">
      <img src={cover} alt="" aria-hidden="true" class="book-art" />
      <div class="book-face">
        <span class="book-brand">Best OutDoor Wears</span>
        <span class="book-title">TrailReady</span>
        <span class="book-rule" aria-hidden="true"></span>
        <span class="book-sub">A Layering &amp;<br />Packing System</span>
        <span class="book-foot">5 trip types · checklists · recipes</span>
      </div>
    </div>
    <div class="book-pages" aria-hidden="true"></div>
  </div>
</div>

<style>
  .book-mockup {
    --book-h: calc(var(--book-w) * 1.42);
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 18px 0 26px;
    perspective: 1600px;
  }

  .book {
    position: relative;
    width: var(--book-w);
    height: var(--book-h);
    transform-style: preserve-3d;
    transform: rotateY(-21deg) rotateX(3deg);
    filter: drop-shadow(0 28px 34px rgba(11, 20, 14, 0.42));
  }

  .book-cover {
    position: absolute;
    inset: 0;
    border-radius: 3px 7px 7px 3px;
    overflow: hidden;
    background: #14261D;
  }

  .book-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the cover art dark enough for the title to hold contrast. */
    filter: brightness(0.62) saturate(0.92);
  }

  /* Spine shading down the left edge, plus a highlight along the fold. */
  .book-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.28) 4%,
        rgba(255, 255, 255, 0.10) 7%,
        rgba(0, 0, 0, 0) 16%),
      linear-gradient(180deg,
        rgba(11, 18, 10, 0.30) 0%,
        rgba(11, 18, 10, 0.62) 62%,
        rgba(11, 18, 10, 0.86) 100%);
  }

  .book-face {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: calc(var(--book-w) * 0.115) calc(var(--book-w) * 0.085)
             calc(var(--book-w) * 0.09) calc(var(--book-w) * 0.13);
    color: #fff;
    text-align: left;
  }

  .book-brand {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: calc(var(--book-w) * 0.038);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #F0B08A;
  }

  .book-title {
    font-family: "Big Shoulders Display", "Arial Narrow", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.9;
    font-size: calc(var(--book-w) * 0.215);
    margin-top: calc(var(--book-w) * 0.055);
  }

  .book-rule {
    display: block;
    width: calc(var(--book-w) * 0.22);
    height: 3px;
    background: #B84E1F;
    margin: calc(var(--book-w) * 0.055) 0;
  }

  .book-sub {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: calc(var(--book-w) * 0.072);
    line-height: 1.28;
    color: #E4EADF;
  }

  .book-foot {
    margin-top: auto;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: calc(var(--book-w) * 0.032);
    letter-spacing: 0.03em;
    color: #C2CFBC;
    white-space: nowrap;
  }

  /* Stacked page edges along the right side. */
  .book-pages {
    position: absolute;
    top: 1.5%;
    right: 0;
    height: 97%;
    width: calc(var(--book-w) * 0.055);
    transform: translateX(99%) rotateY(78deg);
    transform-origin: left center;
    background: repeating-linear-gradient(
      90deg,
      #f4f2e7 0 1px,
      #d9d6c4 1px 2px,
      #fbfaf3 2px 3px
    );
    border-radius: 1px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .book { transition: transform 0.5s ease; }
    .book:hover { transform: rotateY(-12deg) rotateX(2deg); }
  }

  @media (max-width: 620px) {
    .book-mockup { --book-w: 220px; }
  }
</style>
