---
import { url } from '../lib/paths';

interface Props {
  /** Width of the front card, in pixels. */
  width?: number;
}

const { width = 240 } = Astro.props;
const art = url('/images/IMG_8867.jpeg');

// The fanned cards behind the front one, tinted by category.
const fan = [
  { rot: -16, x: -46, y: 12, color: 'var(--card-green)' },
  { rot: -8, x: -24, y: 5, color: 'var(--card-yellow)' },
  { rot: 8, x: 24, y: 5, color: 'var(--card-blue)' },
  { rot: 16, x: 46, y: 12, color: 'var(--card-red)' },
];
---
<div class="deck-mockup" style={`--card-w:${width}px`}>
  <div class="deck">
    {fan.map((f) => (
      <div
        class="deck-back"
        style={`--rot:${f.rot}deg; --tx:${f.x}px; --ty:${f.y}px; --tint:${f.color}`}
      />
    ))}
    <div class="deck-front">
      <img src={art} alt="" aria-hidden="true" class="deck-art" />
      <div class="deck-face">
        <span class="deck-brand">Best OutDoor Wears</span>
        <span class="deck-title">Survival<br />Cards</span>
        <span class="deck-rule" aria-hidden="true"></span>
        <span class="deck-sub">89 cards.<br />5 ways to play.</span>
        <span class="deck-foot">Print · cut · pack</span>
      </div>
    </div>
  </div>
</div>

<style>
  .deck-mockup {
    --card-h: calc(var(--card-w) * 1.4);
    --card-green: #3F7D4E;
    --card-blue: #2E6284;
    --card-yellow: #C08A1E;
    --card-red: #A8342A;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 34px 0 30px;
  }

  .deck {
    position: relative;
    width: var(--card-w);
    height: var(--card-h);
  }

  .deck-back,
  .deck-front {
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }

  .deck-back {
    background: var(--tint);
    transform: translate(var(--tx), var(--ty)) rotate(var(--rot));
    box-shadow: 0 10px 22px -12px rgba(11, 20, 14, 0.55);
    border: 2px solid rgba(255, 255, 255, 0.55);
  }

  /* A hint of the header strip every real card carries. */
  .deck-back::after {
    content: "";
    position: absolute;
    inset: 8px 8px auto 8px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.45);
  }

  .deck-front {
    overflow: hidden;
    background: #14261D;
    border: 2px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 22px 40px -16px rgba(11, 20, 14, 0.6);
  }

  .deck-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55) saturate(0.9);
  }

  .deck-front::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(11, 18, 10, 0.30) 0%,
      rgba(11, 18, 10, 0.66) 58%,
      rgba(11, 18, 10, 0.88) 100%);
  }

  .deck-face {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: calc(var(--card-w) * 0.10);
    color: #fff;
  }

  .deck-brand {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: calc(var(--card-w) * 0.043);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #F0B08A;
  }

  .deck-title {
    font-family: "Big Shoulders Display", "Arial Narrow", sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.88;
    font-size: calc(var(--card-w) * 0.235);
    margin-top: calc(var(--card-w) * 0.05);
  }

  .deck-rule {
    display: block;
    width: calc(var(--card-w) * 0.24);
    height: 3px;
    background: #B84E1F;
    margin: calc(var(--card-w) * 0.05) 0;
  }

  .deck-sub {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: calc(var(--card-w) * 0.078);
    line-height: 1.3;
    color: #E4EADF;
  }

  .deck-foot {
    margin-top: auto;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: calc(var(--card-w) * 0.04);
    letter-spacing: 0.06em;
    color: #C2CFBC;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .deck-back { transition: transform 0.45s ease; }
    .deck:hover .deck-back { transform: translate(calc(var(--tx) * 1.35), var(--ty)) rotate(calc(var(--rot) * 1.25)); }
  }

  @media (max-width: 620px) {
    .deck-mockup { --card-w: 190px; }
  }
</style>
