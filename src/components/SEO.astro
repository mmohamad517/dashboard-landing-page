---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  structuredData?: object | object[];
}

const { title, description, canonicalPath, ogImage, structuredData } = Astro.props;
// Astro.site + BASE_URL keep canonical URLs correct on both the custom domain
// (served from the root) and the GitHub Pages project subpath.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://bestoutdoorwears.com';
const canonical = `${site}${base}${canonicalPath}`;
const image = `${site}${base}${ogImage ?? '/og-default.jpg'}`;
const jsonLd = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content="Best OutDoor Wears" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{jsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
