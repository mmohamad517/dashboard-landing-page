---
import SEO from '../components/SEO.astro';
import { url } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  structuredData?: object | object[];
}

const { title, description, canonicalPath, ogImage, structuredData } = Astro.props;

// Built as a string so the font URLs pick up the configured base path.
const face = (family: string, style: string, weight: number, file: string) => `
    @font-face {
      font-family: "${family}";
      font-style: ${style}; font-weight: ${weight}; font-display: swap;
      src: url("${url(`/fonts/${file}`)}") format("woff2");
    }`;

const fontFaceCss = [
  face('Big Shoulders Display', 'normal', 700, 'big-shoulders-display-latin-700-normal.woff2'),
  face('Big Shoulders Display', 'normal', 800, 'big-shoulders-display-latin-800-normal.woff2'),
  face('Source Serif 4', 'normal', 400, 'source-serif-4-latin-400-normal.woff2'),
  face('Source Serif 4', 'italic', 400, 'source-serif-4-latin-400-italic.woff2'),
  face('Source Serif 4', 'normal', 600, 'source-serif-4-latin-600-normal.woff2'),
  face('IBM Plex Mono', 'normal', 500, 'ibm-plex-mono-latin-500-normal.woff2'),
  face('IBM Plex Mono', 'normal', 600, 'ibm-plex-mono-latin-600-normal.woff2'),
].join('');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SEO title={title} description={description} canonicalPath={canonicalPath} ogImage={ogImage} structuredData={structuredData} />

  <!-- Google Search Console ownership verification. Removing this un-verifies
       the property, so leave it in place. -->
  <meta name="google-site-verification" content="FWuQiugsNWgHqY1BIRFfnYqbEM_77kGr4RrQCTUStyI" />

  <!-- Hero image on the homepage: the LCP element, so start it with the HTML -->
  {canonicalPath === '/' && (
    <link rel="preload" as="image" href={url('/images/hero-trail.webp')} fetchpriority="high" />
  )}

  <!-- Self-hosted fonts: preload only the weights used above the fold -->
  <link rel="preload" href={url('/fonts/big-shoulders-display-latin-800-normal.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={url('/fonts/source-serif-4-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={url('/fonts/ibm-plex-mono-latin-600-normal.woff2')} as="font" type="font/woff2" crossorigin />

  <!-- Critical, above-the-fold CSS inlined to avoid render-blocking -->
  <style is:inline set:html={fontFaceCss} />
  <style is:inline>
    :root {
      --bg: #EEF0E3; --bg-elevated: #F9FAF2; --bg-card: #FFFFFF;
      --ink: #1B211C; --ink-soft: #4B5749; --ink-faint: #7C8A78;
      --pine: #1F3A2E; --pine-deep: #14261D; --rust: #B84E1F;
      --rust-soft: #E9C3AE; --tan: #C9B896; --line: #D6D3BE;
      --max: 1120px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--bg); color: var(--ink);
      font-family: "Source Serif 4", Georgia, "Noto Serif", serif;
      font-size: 17px; line-height: 1.65; -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4, .display {
      font-family: "Big Shoulders Display", "Arial Narrow", sans-serif;
      font-weight: 800; text-transform: uppercase; letter-spacing: 0.01em;
      text-wrap: balance; color: var(--ink); margin: 0;
    }
    .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
    a { color: inherit; }
    img, svg { display: block; max-width: 100%; height: auto; }
    .wrap { max-width: var(--max); margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }

    header.site { padding: 20px 0; border-bottom: 1px solid var(--line); background: var(--bg); }
    .site-header-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .wordmark { display: flex; align-items: baseline; gap: 10px; text-decoration: none; }
    .wordmark .display { font-size: 1.3rem; letter-spacing: 0.02em; }
    .wordmark .accent { color: var(--rust); }
    nav.site-nav { display: flex; gap: 22px; font-family: "IBM Plex Mono", monospace; font-size: 0.76rem; letter-spacing: 0.03em; text-transform: uppercase; flex-wrap: wrap; }
    nav.site-nav a { text-decoration: none; color: var(--ink-soft); }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: "IBM Plex Mono", monospace; font-size: 0.76rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none;
      padding: 11px 20px; border-radius: 3px; border: 1.5px solid var(--pine);
    }
    .btn-primary { background: var(--rust); border-color: var(--rust); color: #fff; }
    .btn-ghost { color: var(--pine); background: transparent; }

    main { min-height: 40vh; }

    /* Full-width hero banner — above the fold, so kept in critical CSS */
    .hero-banner { position: relative; isolation: isolate; overflow: hidden; }
    .hero-bg {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; z-index: -2;
    }
    .hero-banner::after {
      content: ""; position: absolute; inset: 0; z-index: -1;
      background: linear-gradient(
        100deg,
        rgba(11,18,10,0.92) 0%,
        rgba(11,18,10,0.78) 42%,
        rgba(11,18,10,0.42) 72%,
        rgba(11,18,10,0.30) 100%
      );
    }
    .hero-banner-inner {
      position: relative;
      padding: clamp(64px, 11vw, 132px) clamp(20px, 4vw, 48px) clamp(56px, 9vw, 108px);
      max-width: var(--max); margin: 0 auto;
    }
    .hero-banner .label { color: #F0B08A; }
    .hero-banner h1 {
      font-size: clamp(2.4rem, 6.4vw, 4.3rem); line-height: 0.96;
      color: #FFFFFF; margin-top: 12px; max-width: 17ch;
    }
    .hero-banner h1 .accent { color: #FF8F55; }
    .hero-banner .lede {
      margin-top: 18px; font-size: clamp(1rem, 1.6vw, 1.16rem);
      color: #DCE4D7; max-width: 50ch;
    }
    .hero-banner .hero-actions { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
    .hero-banner .btn-ghost { color: #FFFFFF; border-color: rgba(255,255,255,0.55); }
    .hero-banner .free-link { margin-top: 18px; font-size: 0.95rem; }
    .hero-banner .free-link a { color: #F0B08A; }
    .hero-credit {
      position: absolute; right: 12px; bottom: 8px; z-index: 1;
      font-family: "IBM Plex Mono", monospace; font-size: 0.62rem;
      color: rgba(255,255,255,0.55); margin: 0;
    }
  </style>

  <!-- Remaining CSS: non-blocking -->
  <link rel="preload" as="style" href={url('/global.css?v=1')} onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href={url('/global.css?v=1')} /></noscript>
</head>
<body>
  <header class="site">
    <div class="wrap site-header-row">
      <a class="wordmark" href={url('/')}>
        <span class="display">Best OutDoor <span class="accent">Wears</span></span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href={url('/camping-checklist/')}>Free Checklist</a>
        <a href={url('/#layering')}>What to Wear</a>
        <a href={url('/#skills')}>The Skills</a>
        <a href={url('/product/')}>The Kit</a>
        <a href={url('/#articles')}>Guides</a>
        <a href={url('/faq/')}>FAQ</a>
      </nav>
      <a class="btn btn-primary" href={url('/product/')}>Get TrailReady</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <div>
        <span class="mono footer-word">bestoutdoorwears.com</span>
        <p class="footer-tag">Pack right, then know what to do — outdoor skills for beginners.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href={url('/about/')}>About</a>
        <a href={url('/contact/')}>Contact</a>
        <a href={url('/faq/')}>FAQ</a>
        <a href={url('/privacy/')}>Privacy Policy</a>
        <a href={url('/terms/')}>Terms</a>
        <a href={url('/affiliate-disclosure/')}>Affiliate Disclosure</a>
      </nav>
    </div>
  </footer>
</body>
</html>
