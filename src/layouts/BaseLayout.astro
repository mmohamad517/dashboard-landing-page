---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  structuredData?: object | object[];
}

const { title, description, canonicalPath, ogImage, structuredData } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SEO title={title} description={description} canonicalPath={canonicalPath} ogImage={ogImage} structuredData={structuredData} />

  <!-- Self-hosted fonts: preload only the weights used above the fold -->
  <link rel="preload" href="/fonts/big-shoulders-display-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ibm-plex-mono-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Critical, above-the-fold CSS inlined to avoid render-blocking -->
  <style is:inline>
    @font-face {
      font-family: "Big Shoulders Display";
      font-style: normal; font-weight: 700; font-display: swap;
      src: url("/fonts/big-shoulders-display-latin-700-normal.woff2") format("woff2");
    }
    @font-face {
      font-family: "Big Shoulders Display";
      font-style: normal; font-weight: 800; font-display: swap;
      src: url("/fonts/big-shoulders-display-latin-800-normal.woff2") format("woff2");
    }
    @font-face {
      font-family: "Source Serif 4";
      font-style: normal; font-weight: 400; font-display: swap;
      src: url("/fonts/source-serif-4-latin-400-normal.woff2") format("woff2");
    }
    @font-face {
      font-family: "Source Serif 4";
      font-style: italic; font-weight: 400; font-display: swap;
      src: url("/fonts/source-serif-4-latin-400-italic.woff2") format("woff2");
    }
    @font-face {
      font-family: "Source Serif 4";
      font-style: normal; font-weight: 600; font-display: swap;
      src: url("/fonts/source-serif-4-latin-600-normal.woff2") format("woff2");
    }
    @font-face {
      font-family: "IBM Plex Mono";
      font-style: normal; font-weight: 500; font-display: swap;
      src: url("/fonts/ibm-plex-mono-latin-500-normal.woff2") format("woff2");
    }
    @font-face {
      font-family: "IBM Plex Mono";
      font-style: normal; font-weight: 600; font-display: swap;
      src: url("/fonts/ibm-plex-mono-latin-600-normal.woff2") format("woff2");
    }

    :root {
      --bg: #EEF0E3; --bg-elevated: #F9FAF2; --bg-card: #FFFFFF;
      --ink: #1B211C; --ink-soft: #4B5749; --ink-faint: #7C8A78;
      --pine: #1F3A2E; --pine-deep: #14261D; --rust: #B84E1F;
      --rust-soft: #E9C3AE; --tan: #C9B896; --line: #D6D3BE;
      --max: 1120px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--bg); color: var(--ink);
      font-family: "Source Serif 4", Georgia, "Noto Serif", serif;
      font-size: 17px; line-height: 1.65; -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4, .display {
      font-family: "Big Shoulders Display", "Arial Narrow", sans-serif;
      font-weight: 800; text-transform: uppercase; letter-spacing: 0.01em;
      text-wrap: balance; color: var(--ink); margin: 0;
    }
    .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
    a { color: inherit; }
    img, svg { display: block; max-width: 100%; height: auto; }
    .wrap { max-width: var(--max); margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }

    header.site { padding: 20px 0; border-bottom: 1px solid var(--line); background: var(--bg); }
    .site-header-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .wordmark { display: flex; align-items: baseline; gap: 10px; text-decoration: none; }
    .wordmark .display { font-size: 1.3rem; letter-spacing: 0.02em; }
    .wordmark .accent { color: var(--rust); }
    nav.site-nav { display: flex; gap: 22px; font-family: "IBM Plex Mono", monospace; font-size: 0.76rem; letter-spacing: 0.03em; text-transform: uppercase; flex-wrap: wrap; }
    nav.site-nav a { text-decoration: none; color: var(--ink-soft); }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: "IBM Plex Mono", monospace; font-size: 0.76rem; font-weight: 600;
      letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none;
      padding: 11px 20px; border-radius: 3px; border: 1.5px solid var(--pine);
    }
    .btn-primary { background: var(--rust); border-color: var(--rust); color: #fff; }
    .btn-ghost { color: var(--pine); background: transparent; }

    main { min-height: 40vh; }
  </style>

  <!-- Remaining CSS: non-blocking -->
  <link rel="preload" as="style" href="/global.css?v=1" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="/global.css?v=1" /></noscript>
</head>
<body>
  <header class="site">
    <div class="wrap site-header-row">
      <a class="wordmark" href="/">
        <span class="display">Best OutDoor <span class="accent">Wears</span></span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/#layers">The System</a>
        <a href="/product/">TrailReady</a>
        <a href="/#articles">Guides</a>
        <a href="/faq/">FAQ</a>
      </nav>
      <a class="btn btn-primary" href="/product/">Get TrailReady</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <div>
        <span class="mono footer-word">bestoutdoorwears.com</span>
        <p class="footer-tag">A layering &amp; packing system for people who'd rather hike than guess.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/faq/">FAQ</a>
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms</a>
        <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
      </nav>
    </div>
  </footer>
</body>
</html>
